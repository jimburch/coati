DATABASE_URL=postgresql://coati:coati@localhost:5432/coati_dev
DATABASE_URL_TEST=postgresql://coati:coati@localhost:5433/coati_test
POSTGRES_USER=coati
POSTGRES_PASSWORD=coati
POSTGRES_DB=coati_dev
# Coati Dev GitHub OAuth app (Device Flow enabled).
# Callback stays http://localhost:5173/auth/callback/github — `pnpm dev` / `npm run dev` reads these.
# Coati Test (develop.coati.sh) and Coati Prod (coati.sh) credentials are Worker secrets, not this file.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public base URL for generating absolute Open Graph meta tag URLs (no trailing slash)
PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_BETA_MODE=false
# PUBLIC_ENV=  # leave unset for local; set to 'staging' or 'production' in deployed environments
# PUBLIC_SENTRY_DSN=  # Sentry DSN for error capture; leave unset locally to disable Sentry
# PUBLIC_APP_VERSION=  # injected at deploy time; leave unset locally
# DISABLE_RATE_LIMIT=true  # skip the Workers rate-limit binding locally
# PUBLIC_MIXPANEL_TOKEN=  # Mixpanel project token for client-side analytics; leave unset locally to disable tracking
