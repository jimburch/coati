{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "coati-cron",
	// Not a secret. Named environments inherit this.
	"account_id": "98e35850d8eb904f5f11f1b537132362",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-15",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	},
	// Crons run in production only. Refresh dev on demand with
	// `wrangler dev --env dev --test-scheduled --config workers/cron/wrangler.jsonc`.
	"env": {
		"production": {
			"name": "coati-cron-prod",
			"triggers": {
				"crons": ["0 */2 * * *"]
			},
			"vars": {
				"PUBLIC_ENV": "production",
				"PUBLIC_SENTRY_DSN": "",
				"PUBLIC_APP_VERSION": ""
			},
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "ac509d55d4a549b9935917e386df6e1e"
				}
			]
		},
		"dev": {
			"name": "coati-cron-dev",
			"vars": {
				"PUBLIC_ENV": "staging",
				"PUBLIC_SENTRY_DSN": "",
				"PUBLIC_APP_VERSION": ""
			},
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "51967bcc2bfb4767b8bd84ac02c40794",
					"localConnectionString": "postgresql://coati:coati@localhost:5432/coati_dev"
				}
			]
		}
	}
}
